local function createSubButton(name, text, pos, size)
    local btnSize = size or UDim2.new(0, 36, 0, 36)
    local btn = Instance.new("TextButton", ScreenGui)
    btn.Name = name
    btn.Size = btnSize
    btn.Position = pos
    btn.BackgroundColor3 = Color3.fromRGB(20, 24, 32)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextColor3 = Color3.fromRGB(220, 230, 250)
    btn.TextSize = 10
    btn.Visible = false
    btn.Active = true
    btn.Draggable = true
    
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local stroke = Instance.new("UIStroke", btn)
    stroke.Color = Color3.fromRGB(35, 42, 55)
    stroke.Thickness = 1.5
    AddBounceEffect(btn, btnSize)
    return btn, stroke
end

