local fixLagConnection = nil

local function isProtectedObject(obj)
    local success, result = pcall(function()
        if obj:IsDescendantOf(LocalPlayer.Character) then return true end
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and obj:IsDescendantOf(p.Character) then return true end
        end
        local model = obj:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChildOfClass("Humanoid") then
            return true
        end
        if obj:FindFirstChild("UniversalESP") or obj.Name == "UniversalESP" or obj.Name == "ESPNameTag" then return true end
        return false
    end)
    return success and result or false
end

local function cleanObject(obj)
    pcall(function()
        if not State.FixLag or isProtectedObject(obj) then return end
        
        if obj:IsA("BasePart") then
            if obj.Size.Magnitude < 25 and not obj.Anchored and obj.Transparency < 1 then
                pcall(function() obj:Destroy() end)
            else
                OriginalPartMaterials[obj] = obj.Material
                obj.Material = Enum.Material.SmoothPlastic
                obj.Reflectance = 0
                obj.CastShadow = false
            end
        elseif obj:IsA("Decal") or obj:IsA("Texture") or obj:IsA("SpecialMesh") then
            pcall(function() obj:Destroy() end)
        elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Sparkles") or obj:IsA("Explosion") then
            pcall(function() obj:Destroy() end)
        end
    end)
end

local function applyFixLag(enable)
    pcall(function()
        if enable then
            Lighting.GlobalShadows = false
            Lighting.Brightness = 1
            local existingSky = Lighting:FindFirstChildOfClass("Sky")
            if not existingSky then existingSky = Instance.new("Sky", Lighting) end
            existingSky.SkyboxBk, existingSky.SkyboxDn, existingSky.SkyboxFt, existingSky.SkyboxLf, existingSky.SkyboxRt, existingSky.SkyboxUp = "rbxassetid://0", "rbxassetid://0", "rbxassetid://0", "rbxassetid://0", "rbxassetid://0", "rbxassetid://0"
            
            for _, obj in pairs(workspace:GetDescendants()) do
                cleanObject(obj)
            end
            
            fixLagConnection = workspace.DescendantAdded:Connect(function(obj)
                if not State.FixLag then return end
                task.defer(function()
                    cleanObject(obj)
                end)
            end)
            table.insert(Connections, fixLagConnection)
        else
            if fixLagConnection then
                fixLagConnection:Disconnect()
                fixLagConnection = nil
            end
            for part, mat in pairs(OriginalPartMaterials) do
                if part and part.Parent then
                    pcall(function() part.Material = mat part.CastShadow = true end)
                end
            end
            OriginalPartMaterials = {}
        end
    end)
end

