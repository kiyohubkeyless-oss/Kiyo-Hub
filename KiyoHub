local function applyXRay(enable)
    task.spawn(function()
        pcall(function()
            if enable then
                OriginalXRayTransparency = {}
                for _, part in pairs(workspace:GetDescendants()) do
                    if part:IsA("BasePart") then
                        local isPlayerPart = false
                        if LocalPlayer.Character and part:IsDescendantOf(LocalPlayer.Character) then
                            isPlayerPart = true
                        else
                            for _, p in pairs(Players:GetPlayers()) do
                                if p.Character and part:IsDescendantOf(p.Character) then
                                    isPlayerPart = true
                                    break
                                end
                            end
                        end
                        if not isPlayerPart then
                            OriginalXRayTransparency[part] = part.LocalTransparencyModifier
                            part.LocalTransparencyModifier = 0.9
                        end
                    end
                end
            else
                for part, origTrans in pairs(OriginalXRayTransparency) do
                    if part and part.Parent then part.LocalTransparencyModifier = origTrans end
                end
                OriginalXRayTransparency = {}
            end
        end)
    end)
end

