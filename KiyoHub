        toggleBtn.MouseButton1Up:Connect(function()
            pcall(function()
                TweenService:Create(toggleBtn, TweenInfo.new(0.06, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 32, 0, 18)}):Play()
            end)
        end)
        
        local circle = Instance.new("Frame", toggleBtn)
        circle.Size = UDim2.new(0, 14, 0, 14)
        circle.Position = UDim2.new(0, 2, 0.5, -7)
        circle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)
        
        local toggled = data.CurrentValue or false
        local function updateToggle(val, noSave)
            toggled = val
            PlayUISound(226892749, 1)
            if toggled then
                toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 130, 255)
                circle:TweenPosition(UDim2.new(1, -16, 0.5, -7), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.1, true)
            else
                toggleBtn.BackgroundColor3 = Color3.fromRGB(35, 42, 55)
                circle:TweenPosition(UDim2.new(0, 2, 0.5, -7), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.1, true)
            end
            if not noSave then
                State[data.Name] = toggled
                TriggerAutoSave()
            end
            if data.Callback then pcall(function() data.Callback(toggled) end) end
        end
        
        if toggled then updateToggle(true, true) end
        
        toggleBtn.MouseButton1Click:Connect(function()
            updateToggle(not toggled)
        end)
    end
    
