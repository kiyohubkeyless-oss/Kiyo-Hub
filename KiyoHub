local function applyRagdoll(char, enable)
    pcall(function()
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        
        if enable then
            hum.PlatformStand = true
            if hum.RigType == Enum.HumanoidRigType.R6 then
                local torso = char:FindFirstChild("Torso")
                if torso then
                    r6JointsData[char] = {}
                    for _, jointName in ipairs({"Neck", "Left Shoulder", "Right Shoulder", "Left Hip", "Right Hip"}) do
                        local joint = torso:FindFirstChild(jointName)
                        if joint and joint:IsA("Motor6D") then
                            r6JointsData[char][jointName] = {
                                Part0 = joint.Part0,
                                Part1 = joint.Part1,
                                C0 = joint.C0,
                                C1 = joint.C1
                            }
                            local part1 = joint.Part1
                            if part1 then
                                joint.Part0 = nil
                                local att0 = Instance.new("Attachment")
                                att0.CFrame = joint.C0
                                att0.Parent = torso
                                att0.Name = "RagdollAtt0_" .. jointName
                                
                                local att1 = Instance.new("Attachment")
                                att1.CFrame = joint.C1
                                att1.Parent = part1
                                att1.Name = "RagdollAtt1_" .. jointName
                                
                                local constraint = Instance.new("BallSocketConstraint")
                                constraint.Attachment0 = att0
                                constraint.Attachment1 = att1
                                constraint.Parent = torso
                                constraint.Name = "RagdollConstraint_" .. jointName
                            end
                        end
                    end
                end
            end
        else
            hum.PlatformStand = false
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            local torso = char:FindFirstChild("Torso")
            if torso then
                for _, child in ipairs(torso:GetChildren()) do
                    if child.Name:sub(1, 16) == "RagdollConstraint_" or child.Name:sub(1, 13) == "RagdollAtt0_" then
                        child:Destroy()
                    end
                end
                for _, part in ipairs(char:GetChildren()) do
                    if part:IsA("BasePart") then
                        for _, child in ipairs(part:GetChildren()) do
                            if child.Name:sub(1, 13) == "RagdollAtt1_" then
                                child:Destroy()
                            end
                        end
                    end
                end
                if r6JointsData[char] then
                    for jointName, data in pairs(r6JointsData[char]) do
                        local joint = torso:FindFirstChild(jointName)
                        if joint and joint:IsA("Motor6D") then
                            joint.Part0 = data.Part0
                            joint.Part1 = data.Part1
                            joint.C0 = data.C0
                            joint.C1 = data.C1
                        end
                    end
                    r6JointsData[char] = nil
                end
            end
        end
    end)
end

local function applyHeadless(char, enable)
    pcall(function()
        if not char then return end
        local head = char:FindFirstChild("Head")
        if head then
            if enable then
