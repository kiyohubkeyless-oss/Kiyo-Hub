-- ==================== AUTO SAVE CONFIG SYSTEM ====================
local SAVE_FILE_NAME = "KiyoHub_Settings.json"
local AutoSaveEnabled = false
local SavedStateData = {}

local function LoadSavedConfig()
    pcall(function()
        if readfile and isfile and isfile(SAVE_FILE_NAME) then
            local content = readfile(SAVE_FILE_NAME)
            local data = HttpService:JSONDecode(content)
            if data then
                SavedStateData = data
                if data.AutoSave ~= nil then AutoSaveEnabled = data.AutoSave end
                if data.Language ~= nil then CurrentLanguage = data.Language end
            end
        end
    end)
end

local function SaveCurrentConfig(currentStates, lang)
    pcall(function()
        if not AutoSaveEnabled then
            if writefile and isfile and isfile(SAVE_FILE_NAME) then
                delfile(SAVE_FILE_NAME)
            end
            return
        end
        if writefile then
            local dataToSave = {
                AutoSave = true,
                Language = lang,
                States = currentStates
            }
            writefile(SAVE_FILE_NAME, HttpService:JSONEncode(dataToSave))
        end
    end)
end

