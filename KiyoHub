-- KiyoHub Troll Screen - Chó Khánh Ngu
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ParentGui = (gethui and gethui()) or game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")

-- Xóa GUI cũ nếu có để tránh trùng lặp
if ParentGui:FindFirstChild("ChoKhanhNguGui") then
    ParentGui.ChoKhanhNguGui:Destroy()
end

local ScreenGui = Instance.new("ScreenGui", ParentGui)
ScreenGui.Name = "ChoKhanhNguGui"
ScreenGui.ResetOnSpawn = false
ScreenGui.DisplayOrder = 999999 -- Đặt cực cao để đè lên mọi nút thoát / UI khác

-- Khung nền đen che kín màn hình (có thể chỉnh BackgroundTransparency nếu muốn mờ ảo)
local BackgroundFrame = Instance.new("Frame", ScreenGui)
BackgroundFrame.Size = UDim2.new(1, 0, 1, 0)
BackgroundFrame.Position = UDim2.new(0, 0, 0, 0)
BackgroundFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
BackgroundFrame.BackgroundTransparency = 0.15 -- Che gần như kín đặc, ko bấm được gì bên dưới
BackgroundFrame.BorderSizePixel = 0
BackgroundFrame.Active = true -- Chặn click xuyên qua

-- Chữ to đùng chính giữa
local BigText = Instance.new("TextLabel", BackgroundFrame)
BigText.Size = UDim2.new(1, 0, 1, 0)
BigText.Position = UDim2.new(0, 0, 0, 0)
BigText.BackgroundTransparency = 1
BigText.Text = "CHÓ KHÁNH NGU"
BigText.TextColor3 = Color3.fromRGB(255, 0, 0) -- Chữ đỏ rực nổi bật
BigText.Font = Enum.Font.GothamBlack
BigText.TextScaled = true -- Tự động co giãn full màn hình cực to
BigText.TextWrapped = true

-- Hiệu ứng viền chữ cho nổi (tùy chọn)
local TextStroke = Instance.new("UIStroke", BigText)
TextStroke.Color = Color3.fromRGB(255, 255, 255)
TextStroke.Thickness = 3
