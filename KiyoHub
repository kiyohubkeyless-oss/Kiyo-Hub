local SafeSpotContainer = Instance.new("Folder", ScreenGui)
SafeSpotContainer.Name = "SafeSpotContainer"

local function updateSafeSpotButtons()
    pcall(function()
        SafeSpotContainer:ClearAllChildren()
        if not State.SafeSpot then return end
        local count = State.SafeSpotCount or 3
        for i = 1, count do
            local btn = Instance.new("TextButton", SafeSpotContainer)
            btn.Size = UDim2.new(0, 36, 0, 36)
            btn.Position = UDim2.new(0.35 + ((i - 1) * 0.045), 0, 0.05, 0)
            btn.BackgroundColor3 = Color3.fromRGB(20, 24, 32)
            btn.Text = "S" .. i
            btn.Font = Enum.Font.GothamBold
            btn.TextColor3 = Color3.fromRGB(220, 230, 250)
            btn.TextSize = 10
            btn.Active = true
            btn.Draggable = true
            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
            local stroke = Instance.new("UIStroke", btn)
            stroke.Color = Color3.fromRGB(35, 42, 55)
            stroke.Thickness = 1.5
            AddBounceEffect(btn, UDim2.new(0, 36, 0, 36))

            if State.SafeSpots[i] then
                btn.BackgroundColor3 = Color3.fromRGB(0, 130, 255)
                btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                stroke.Color = Color3.fromRGB(100, 180, 255)
                btn.Text = "TP" .. i
            end

            btn.MouseButton1Click:Connect(function()
                pcall(function()
                    local char = LocalPlayer.Character
                    if char and char:FindFirstChild("HumanoidRootPart") then
                        local hrp = char.HumanoidRootPart
                        if not State.SafeSpots[i] then
                            State.SafeSpots[i] = hrp.CFrame
                            btn.BackgroundColor3 = Color3.fromRGB(0, 130, 255)
                            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
                            stroke.Color = Color3.fromRGB(100, 180, 255)
                            btn.Text = "TP" .. i
                        else
                            hrp.CFrame = State.SafeSpots[i]
                        end
                    end
                end)
            end)
        end
    end)
end

